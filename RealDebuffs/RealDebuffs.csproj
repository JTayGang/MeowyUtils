<Project Sdk="Dalamud.NET.Sdk/15.0.0">
  <PropertyGroup>
    <!-- Let Dalamud.NET.Sdk resolve game references and select its current target framework. -->
    <Authors>Meowmeowmeow Cat</Authors>
    <Company>Meowmeowmeow Cat</Company>
    <Version>1.0.0.0</Version>
    <Description>Turns FFXIV's debuffs into actual screen effects.</Description>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <None Include="RealDebuffs.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Project-wide usings; MathF and DrawHelpers members are called unprefixed -->
  <ItemGroup>
    <Using Include="System.Numerics" />
    <Using Include="Dalamud.Bindings.ImGui" />
    <Using Include="RealDebuffs.Effects" />
    <Using Include="RealDebuffs.Effects.Framework" />
    <Using Include="RealDebuffs.Effects.Framework.Materials" />
    <Using Include="System.MathF" Static="true" />
    <Using Include="RealDebuffs.Effects.Framework.DrawHelpers" Static="true" />
  </ItemGroup>
</Project>
