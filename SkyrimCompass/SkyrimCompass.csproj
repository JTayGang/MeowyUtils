<Project Sdk="Dalamud.NET.Sdk/15.0.0">
  <PropertyGroup>
    <!-- Needs .NET 10 SDK 10.0.101+; DALAMUD_HOME = %APPDATA%\XIVLauncher\addon\Hooks\dev -->
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>

    <!-- Bump before every release so Dalamud offers the update. -->
    <Version>2.1.0.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <!--
      Decodes the base64 Moodles/Loci manager payloads (same MemoryPack version both plugins pin) to read
      each status's absolute ExpiresAt for target-bar timers. See StatusExpiry.cs.
    -->
    <PackageReference Include="MemoryPack" Version="1.21.4" />
    <PackageReference Include="MemoryPack.Core" Version="1.21.4" />
    <PackageReference Include="MemoryPack.Generator" Version="1.21.4" />
  </ItemGroup>
</Project>
