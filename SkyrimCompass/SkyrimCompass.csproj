<Project Sdk="Dalamud.NET.Sdk/15.0.0">
  <PropertyGroup>
    <!--
      Dalamud v15 requires .NET 10 SDK (10.0.101 or later).
      Download from: https://dotnet.microsoft.com/download/dotnet/10.0
      DALAMUD_HOME must point to: %APPDATA%\XIVLauncher\addon\Hooks\dev
    -->
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>

    <!--
      Bump this before every release to trigger an update
      in Dalamud 
    -->
    <Version>2.0.3.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <!--
      Decodes the base64 Moodles/Loci manager payloads (same MemoryPack version both plugins pin) to read
      each status's absolute ExpiresAt for target-bar timers. See StatusExpiry.cs.
    -->
    <PackageReference Include="MemoryPack" Version="1.21.4" />
    <PackageReference Include="MemoryPack.Core" Version="1.21.4" />
    <PackageReference Include="MemoryPack.Generator" Version="1.21.4" />
  </ItemGroup>
</Project>
