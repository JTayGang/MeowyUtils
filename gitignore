# Build output — matches at any depth, so this covers every project in the repo
# (SkyrimCompass/bin, StatusBridge/StatusBridge/bin, and any future project folder)
# without needing a separate rule per project. Bracket-cased to also catch Bin/Obj,
# since this repo has already hit a case-sensitivity surprise once.
[Bb]in/
[Oo]bj/

# Visual Studio
.vs/
*.user
*.suo

# Rider / JetBrains
.idea/

# OS cruft
.DS_Store
Thumbs.db

# NOTE: packages.lock.json is intentionally NOT ignored — that's a committed
# lock file (like package-lock.json), not build output.
